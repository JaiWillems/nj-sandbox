% Ground Station

MIN_INPUT = 0;
MAX_INPUT = 1023;
MID_INPUT = 0.5 * (MIN_INPUT + MAX_INPUT);

Z_DOT_AUTHORITY = 0.33; % [m / s].
MIN_Z_DOT = -Z_DOT_AUTHORITY;
MAX_Z_DOT = Z_DOT_AUTHORITY;

ROLL_AUTHORITY = 0.17453; % [RAD], equivalent to 10 degrees.
MIN_ROLL = -ROLL_AUTHORITY;
MAX_ROLL = ROLL_AUTHORITY;

PITCH_AUTHORITY = 0.17453; % [RAD], equivalent  to 10 degrees.
MIN_PITCH = -PITCH_AUTHORITY;
MAX_PITCH = PITCH_AUTHORITY;

YAW_RATE_AUTHORITY = 0.52360; % [RAD / s], equivalent to 30 deg / s.
MIN_YAW_RATE = -YAW_RATE_AUTHORITY;
MAX_YAW_RATE = YAW_RATE_AUTHORITY;

% Drone

g = 9.81; % [m / s^2], gravitational acceleration.

m = 1.04100; % [kg], drone mass.
L = 0.27250; % [m], arm length.

Ixb = 0.01468; % [kg m^2], body x moment of inertia.
Iyb = 0.01492; % [kg m^2], body y moment of inertia.
Izb = 0.02800; % [kg m^2], body z moment of inertia. 

kF = 0.12139; % [N / PWM], motor force coefficient.
kM = 0.00208; % [Nm / PWM], motor torque coefficient.

max_voltage = 4; % [V], maximum motor voltage.
rpm_per_voltage = 1000; % [RPM / V], motor KV rating.

z_Kp = 50;
z_Ki = 50;
z_Kd = 0;

roll_Kp = 10;
roll_Ki = 0.01;
roll_Kd = 0.6;

pitch_Kp = roll_Kp;
pitch_Ki = roll_Ki;
pitch_Kd = roll_Kd;

yaw_Kp = 1;%0.3;
yaw_Ki = 0.01;
yaw_Kd = 0;
